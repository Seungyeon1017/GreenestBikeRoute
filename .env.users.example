# Settings for user accounts (backend/users/config.py). Copy these lines into .env (git-ignored).

# Used when you run the backend or Alembic on your computer (uv run ...).
# In Docker, compose.yml sets the hostname and port of the "postgres" service instead.
USERS_DATABASE_HOSTNAME=localhost
USERS_DATABASE_PORT=5434
USERS_DATABASE_USERNAME=postgres
USERS_DATABASE_PASSWORD=change-me
USERS_DATABASE_NAME=greenest

# Signs login tokens. Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
USERS_JWT_SECRET_KEY=replace-with-a-long-random-value

USERS_ACCESS_TOKEN_EXPIRE_MINUTES=60
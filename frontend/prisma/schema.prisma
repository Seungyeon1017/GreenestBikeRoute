// Prisma Schema for Klimadashboard
// This schema defines all content models for the dashboard application

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums
enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ImagePosition {
  LEFT
  RIGHT
  BOTTOM
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}
// Models
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          Role     @default(VIEWER)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  accountId    String    @map("account_id")
  providerId   String    @map("provider_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  password     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Tile {
  id        String   @id @default(cuid())
  name      String
  tileId    String
  fullWidth Boolean  @default(false)
  details   String?  @db.Text
  dataUrl   String?
  info      String?  @db.Text
  status    Status   @default(PUBLISHED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations TileTranslation[]

  @@map("tiles")
}

model TileTranslation {
  id        String   @id @default(cuid())
  tileId    String   @map("tile_id")
  locale    String
  name      String
  details   String?  @db.Text
  info      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tile Tile @relation(fields: [tileId], references: [id], onDelete: Cascade)

  @@unique([tileId, locale])
  @@map("tile_translations")
}

model Survey {
  id            String   @id @default(cuid())
  title         String
  question      String   @db.Text
  answerText    String
  answerValue   Float
  answerUnit    String   @default("%")
  category      String
  dataSource    String
  dataRetrieval DateTime
  status        Status   @default(PUBLISHED)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  translations SurveyTranslation[]

  @@map("surveys")
}

model SurveyTranslation {
  id          String   @id @default(cuid())
  surveyId    String   @map("survey_id")
  locale      String
  title       String
  question    String   @db.Text
  answerText  String
  answerValue Float
  answerUnit  String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, locale])
  @@map("survey_translations")
}

model SuccessStory {
  id            String        @id @default(cuid())
  text          String        @db.Text
  link          String
  image         String?
  imagePosition ImagePosition @default(LEFT)
  category      String
  details       String        @db.Text
  status        Status        @default(PUBLISHED)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  translations SuccessStoryTranslation[]

  @@map("success_stories")
}

model SuccessStoryTranslation {
  id             String   @id @default(cuid())
  successStoryId String   @map("success_story_id")
  locale         String
  text           String   @db.Text
  details        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  successStory SuccessStory @relation(fields: [successStoryId], references: [id], onDelete: Cascade)

  @@unique([successStoryId, locale])
  @@map("success_story_translations")
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  slug        String   @unique
  image       String
  status      Status   @default(PUBLISHED)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations CollectionTranslation[]
  tiles CollectionTile[]

  @@map("collections")
}

model CollectionTranslation {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  locale       String
  title        String
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@map("collection_translations")
}

model CollectionTile {
  id           String @id @default(cuid())
  collectionId String
  itemId       String
  itemType     String @map("item_type") // 'tile', 'survey', 'successStory'
  sort         Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("collection_tiles")
}

model Section {
  id        String   @id @default(cuid())
  title     String
  icon      String
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tiles SectionTile[]
  translations SectionTranslation[]

  @@map("sections")
}

model SectionTranslation {
  id        String   @id @default(cuid())
  sectionId String   @map("section_id")
  locale    String
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@map("section_translations")
}

model SectionTile {
  id        String @id @default(cuid())
  sectionId String
  itemId    String
  itemType  String @map("item_type") // 'tile', 'survey', 'successStory'
  sort      Int    @default(0)

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("section_tiles")
}

model AppOptions {
  id           String   @id @default(cuid())
  languages    String[]
  showDatesOn  String?  @map("show_dates_on")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("options")
}

model Theme {
  id                  String   @id @default(cuid())
  title               String
  navbarImage         String
  navbarImageLink     String?
  aboutButtonTitle    String
  aboutButtonText     String   @map("about_button_text") @db.Text
  primary             String
  primaryLight        String
  secondary           String
  secondaryLight      String
  climate             String
  climateLight        String
  buildings           String
  buildingsLight      String
  mobility            String
  mobilityLight       String
  energy              String
  energyLight         String
  borderRadius        Int
  font                String
  successStoriesTitle String
  favIcon             String
  openGraphImage      String
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  translations ThemeTranslation[]

  @@map("themes")
}

model ThemeTranslation {
  id                String   @id @default(cuid())
  themeId           String   @map("theme_id")
  locale            String
  title             String
  aboutButtonTitle  String   @map("about_button_title")
  aboutButtonText   String   @map("about_button_text") @db.Text
  successStoriesTitle String @map("success_stories_title")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, locale])
  @@map("theme_translations")
}

model Impressum {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations ImpressumTranslation[]

  @@map("impressum")
}

model ImpressumTranslation {
  id          String   @id @default(cuid())
  impressumId String   @map("impressum_id")
  locale      String
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  impressum Impressum @relation(fields: [impressumId], references: [id], onDelete: Cascade)

  @@unique([impressumId, locale])
  @@map("impressum_translations")
}

model Datenschutz {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations DatenschutzTranslation[]

  @@map("datenschutz")
}

model DatenschutzTranslation {
  id           String   @id @default(cuid())
  datenschutzId String  @map("datenschutz_id")
  locale       String
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  datenschutz Datenschutz @relation(fields: [datenschutzId], references: [id], onDelete: Cascade)

  @@unique([datenschutzId, locale])
  @@map("datenschutz_translations")
}



model Files {
  id        String   @id @default(cuid())
  s3Key     String
  mime      String
  bucket    String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  color       String   @default("#000000")
  colorLight  String   @default("#f0f0f0") @map("color_light")
  sort        Int      @default(0)
  status      Status   @default(PUBLISHED)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tiles    PageTile[]
  sections PageSection[]
  translations PageTranslation[]

  @@map("pages")
}

model PageTranslation {
  id          String   @id @default(cuid())
  pageId      String   @map("page_id")
  locale      String
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@map("page_translations")
}

model PageTile {
  id       String @id @default(cuid())
  pageId   String @map("page_id")
  itemId   String @map("item_id")
  itemType String @map("item_type") // 'tile', 'survey', 'successStory'
  sort     Int    @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_tiles")
}

model PageSection {
  id       String @id @default(cuid())
  pageId   String @map("page_id")
  itemId   String @map("item_id")
  itemType String @map("item_type") // 'section', 'collection'
  sort     Int    @default(0)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_sections")
}

model Dates {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  image       String?
  link        String?
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations DateTranslation[]

  @@map("dates")
}

model DateTranslation {
  id          String   @id @default(cuid())
  dateId      String   @map("date_id")
  locale      String
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  date Dates @relation(fields: [dateId], references: [id], onDelete: Cascade)

  @@unique([dateId, locale])
  @@map("date_translations")
}

model Material {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  image       String?
  fileUrl     String   @map("file_url")
  status      Status   @default(PUBLISHED)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations MaterialTranslation[]

  @@map("materials")
}

model MaterialTranslation {
  id           String   @id @default(cuid())
  materialId   String   @map("material_id")
  locale       String
  name         String
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, locale])
  @@map("material_translations")
}

# ---------------------
# caddy (only for production)
# ---------------------
APP_URL=your-domain.de
ADMIN_URL=admin.your-domain.de


# ---------------------
# postgres
# ---------------------
DATABASE_DIALECT=postgresql
DATABASE_NAME=klimadashboard
DATABASE_HOST=postgres:5432
DATABASE_USER=user
DATABASE_PASSWORD=password


# ---------------------
# ADMIN JS
# ---------------------
PORT=3001
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}/${DATABASE_NAME}
COOKIE_SECRET=CHANGETHISPLEASE
COOKIE_PASSWORD=CHANGETHISPLEASTOO
ADMIN_EMAIL="EMAILFORADMIN"
ADMIN_PASSWORD_HASH="HASHEDPASSWORD"


# ---------------------
# S3 STORAGE (for image upload)
# ---------------------
HETZNER_ENDPOINT=S3_ENDPOINT
HETZNER_REGION=S3_REGION
HETZNER_ACCESS_KEY=S3_ACCESS_KEY
HETZNER_SECRET_KEY=S3_SECRET_KEY
HETZNER_BUCKET=S3_BUCKET_NAME


# ---------------------
# PRISMA
# ---------------------
MIGRATE_DATABASE=false


# ---------------------
# CONTACT FORM
# ---------------------
# SMTP credentials for outgoing mail
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=user@example.com
CONTACT_SMTP_PASS=password
CONTACT_SMTP_FROM="Green City Heilbronn <noreply@example.com>"
# Comma-separated list of recipient addresses (2-3)
CONTACT_RECIPIENTS=recipient1@example.com,recipient2@example.com